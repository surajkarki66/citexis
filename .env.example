# Copy to .env and fill every value — the app will not start without a complete .env file.
# cp .env.example .env

# App
APP_ENV=development
DEBUG=true

# MongoDB (external — Atlas or host)
# Use a standard mongodb:// URI (not mongodb+srv) if Docker DNS cannot resolve SRV records.
MONGODB_URI=mongodb://host.docker.internal:27017
MONGODB_DB=citexis

# Redis
# Host port for docker compose mapping only (see REDIS_HOST_PORT in docker-compose.yml)
REDIS_HOST_PORT=6380
REDIS_URL=redis://redis:6379/0

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX=papers

# Pinecone
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX=citexis
PINECONE_NAMESPACE=papers-abstract
PINECONE_TEXT_FIELD=text
PINECONE_RERANK_ENABLED=true
PINECONE_RERANK_MODEL=bge-reranker-v2-m3

# CORE full-text enrichment (leave CORE_API_KEY empty to skip)
CORE_API_KEY=
INGESTION_ENRICH_CORE=true
INGESTION_MAX_CITATIONS=100

# Bulk JSON import (Celery worker required)
JSON_IMPORT_MAX_BYTES=1048576
JSON_IMPORT_MAX_PAPERS=500

# Hybrid search
SEARCH_TOP_K_PER_SOURCE=50
SEARCH_RRF_K=60
SEARCH_FUSION_TOP_N=20
SEARCH_FINAL_TOP_N=10

# Auth (JWT)
JWT_SECRET_KEY=change-me-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Bootstrap admin (optional — created/updated on API startup)
AUTH_ADMIN_EMAIL=admin@example.com
AUTH_ADMIN_PASSWORD=change-me-admin-password
